# Control-plane service configuration (copy to .env for local development).
# All variables are prefixed with EDP_.

EDP_SERVICE_NAME=edp-control-plane
EDP_ENVIRONMENT=local
EDP_HOST=0.0.0.0
EDP_PORT=8000
EDP_LOG_LEVEL=info
EDP_LOG_JSON=false
EDP_METRICS_ENABLED=true
EDP_MAX_CONCURRENT_DEPLOYMENTS=25
